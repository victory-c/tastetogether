# Qloo API key, required for live search and recommendations.
QLOO_API_KEY=
# Qloo API host.
QLOO_API_URL=https://hackathon.api.qloo.com
# libSQL database URL; leave empty for the local database.
DATABASE_URL=
# Authentication token for a remote libSQL database.
DATABASE_AUTH_TOKEN=
# Secret for signed sessions; use at least 32 characters in production.
SESSION_SECRET=
# Optional Anthropic key for generated explanations.
ANTHROPIC_API_KEY=
# Optional model for generated explanations.
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional per-process Qloo call limit per hour.
QLOO_MAX_CALLS_PER_HOUR=600
